[
  {
    "id": "A01",
    "text": "지시가 말마다 달라져서 같은 일을 세 번 했어.",
    "칸": "리더십",
    "긴급도": "보통",
    "label_by": "사람",
    "note": ""
  },
  {
    "id": "A02",
    "text": "야근이 3주 연속이라 불면증이 생겼어요.",
    "칸": "안전보건",
    "긴급도": "높음",
    "label_by": "사람",
    "note": "판단이 갈린다"
  },
  {
    "id": "A03",
    "text": "입사한 지 첫 주에 아무도 제 업무를 설명해 주지 않았어요.",
    "칸": "온보딩",
    "긴급도": "높음",
    "label_by": "사람",
    "note": "판단이 갈린다"
  },
  {
    "id": "A04",
    "text": "급여일이 지났는데 월급이 아직 안 들어왔어요. 월세를 내야 해서 너무 급합니다.",
    "칸": "급여",
    "긴급도": "높음",
    "label_by": "사람",
    "note": ""
  },
  {
    "id": "A05",
    "text": "주차장 차량번호 등록이 오류가 나서 입차가 안 돼요.",
    "칸": "기타",
    "긴급도": "낮음",
    "label_by": "사람",
    "note": "판단이 갈린다"
  },
  {
    "id": "A06",
    "text": "급여 명세서에 공제 항목이 뭔지 몰르겠어요",
    "칸": "급여",
    "긴급도": "낮음",
    "label_by": "사람",
    "note": ""
  },
  {
    "id": "A07",
    "text": "평가 결과 면담은 언제 받을 수 있는지 문의드려요.",
    "칸": "평가",
    "긴급도": "낮음",
    "label_by": "사람",
    "note": ""
  },
  {
    "id": "A08",
    "text": "건물 엘리베이터가 자주 멈춰서 출근이 늦어져요.",
    "칸": "기타",
    "긴급도": "낮음",
    "label_by": "사람",
    "note": "판단이 갈린다"
  },
  {
    "id": "A09",
    "text": "신규입사자 교육이 언재 시작하는지 궁금해여",
    "칸": "온보딩",
    "긴급도": "낮음",
    "label_by": "사람",
    "note": ""
  },
  {
    "id": "A10",
    "text": "단체 실손보험 갱신 안내를 못 받아서 보장이 끊겼는지 걱정입니다. 병원 예약이 내일이에요.",
    "칸": "복지",
    "긴급도": "높음",
    "label_by": "사람",
    "note": ""
  },
  {
    "id": "A11",
    "text": "팀에서 한 사람을 따돌리는 일이 계속되고 있습니다. 그분은 결국 병가를 냈어요.",
    "칸": "조직문화",
    "긴급도": "높음",
    "label_by": "사람",
    "note": ""
  },
  {
    "id": "A12",
    "text": "팀장님이 결정을 계속 미뤄서 프로젝트가 멈췄어요. 저희는 손 놓고 있습니다.",
    "칸": "리더십",
    "긴급도": "높음",
    "label_by": "사람",
    "note": ""
  },
  {
    "id": "A13",
    "text": "퇴직금 중간정산이 가능한지 궁금합니다.",
    "칸": "급여",
    "긴급도": "보통",
    "label_by": "사람",
    "note": "판단이 갈린다"
  },
  {
    "id": "A14",
    "text": "입사 첫날인데 노트북이 준비가 안 돼서 하루 종일 아무것도 못 했어요.",
    "칸": "온보딩",
    "긴급도": "높음",
    "label_by": "사람",
    "note": ""
  },
  {
    "id": "A15",
    "text": "복지포인트가 갑자기 0원으로 떴어요. 연말이라 쓸 곳이 많은데.",
    "칸": "복지",
    "긴급도": "높음",
    "label_by": "사람",
    "note": "판단이 갈린다"
  },
  {
    "id": "A16",
    "text": "평가 등급 때문에 올해 승진과 연봉 협상 대상에서 제외됐다는 통보를 받았는데 근거 자료를 못 받아서 이의제기도 못 하고 있어요.",
    "칸": "평가",
    "긴급도": "높음",
    "label_by": "사람",
    "note": ""
  },
  {
    "id": "A17",
    "text": "사내 행사에 가족 동반이 가능한지 궁금합니다.",
    "칸": "복지",
    "긴급도": "낮음",
    "label_by": "사람",
    "note": "판단이 갈린다"
  },
  {
    "id": "A18",
    "text": "팀장님께서 피드벡을 거의 안주셔서 성장하고 있는지 모르겠어요.",
    "칸": "리더십",
    "긴급도": "보통",
    "label_by": "사람",
    "note": ""
  },
  {
    "id": "A19",
    "text": "사무실 에어컨이 고장나서 실내가 33도예요. 일을 못 하겠습니다.",
    "칸": "안전보건",
    "긴급도": "높음",
    "label_by": "사람",
    "note": "판단이 갈린다"
  },
  {
    "id": "A20",
    "text": "성과평가 점수가 팀마다 기준이 달라서 불공정한 것 같음ㅠ",
    "칸": "평가",
    "긴급도": "보통",
    "label_by": "사람",
    "note": ""
  },
  {
    "id": "A21",
    "text": "자기평가서 작성이 시스템에서 저장이 안되서 몇번이나 날렸어요",
    "칸": "평가",
    "긴급도": "높음",
    "label_by": "사람",
    "note": "판단이 갈린다"
  },
  {
    "id": "A22",
    "text": "이번 달 월급이 통째로 누락됐습니다. 전산 오류라는데 아무도 답이 없어요.",
    "칸": "급여",
    "긴급도": "높음",
    "label_by": "사람",
    "note": ""
  },
  {
    "id": "A23",
    "text": "프린터가 전 층에서 안 돼서 계약서 출력을 못 하고 있습니다. 마감이 오늘이에요.",
    "칸": "기타",
    "긴급도": "높음",
    "label_by": "사람",
    "note": ""
  },
  {
    "id": "A24",
    "text": "설문이 정말 익명인지 확인하고 싶습니다.",
    "칸": "기타",
    "긴급도": "낮음",
    "label_by": "사람",
    "note": ""
  },
  {
    "id": "A25",
    "text": "헬스장 제휴 할인 업체 목록 좀 보내주실 수 있나요?",
    "칸": "복지",
    "긴급도": "낮음",
    "label_by": "사람",
    "note": ""
  },
  {
    "id": "A26",
    "text": "리프레쉬 휴가 신청은 어디서 하는지 알려주새요",
    "칸": "복지",
    "긴급도": "낮음",
    "label_by": "사람",
    "note": ""
  },
  {
    "id": "A27",
    "text": "신입이 의견을 내면 '네가 뭘 아냐'는 말부터 나와요.",
    "칸": "조직문화",
    "긴급도": "보통",
    "label_by": "사람",
    "note": ""
  },
  {
    "id": "A28",
    "text": "서진우 부장이 특정 직원만 챙기는 분위기라 팀 전체가 가라앉았어요.",
    "칸": "리더십",
    "긴급도": "보통",
    "label_by": "사람",
    "note": "판단이 갈린다"
  },
  {
    "id": "A29",
    "text": "상사가 저를 보고 소리를 지르며 서류를 던졌습니다. 무서워서 출근을 못 하겠어요.",
    "칸": "리더십",
    "긴급도": "높음",
    "label_by": "사람",
    "note": ""
  },
  {
    "id": "A30",
    "text": "모니터 받침대 신청하고십은데 어디다 말하나요",
    "칸": "안전보건",
    "긴급도": "낮음",
    "label_by": "사람",
    "note": "판단이 갈린다"
  }
]